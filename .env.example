# Builds and unit/local Redis tests need no hosted credentials. The Upstash
# adapter validates these on the server before use. Copy to .env.local; never commit it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Explicit opt-in for developer controls. Keep disabled on public production.
DEMO_MODE=false
# Required when DEMO_MODE=true; use a random value at least 32 characters long.
DEMO_SECRET=
# Runtime API/SSR configuration. Keep the namespace stable across instances,
# and use separate namespaces for development, previews, and production.
CHECKOUT_NAMESPACE=gametime-demo
# Generate TWO distinct values, e.g. run `openssl rand -hex 32` twice.
CHECKOUT_CALLER_SECRET=
CHECKOUT_COMPLETION_SECRET=
# Simulator only. Non-SUCCESS scenarios require DEMO_MODE=true + DEMO_SECRET.
PAYMENT_SCENARIO=SUCCESS
