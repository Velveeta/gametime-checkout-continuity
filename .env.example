# Builds and unit/local Redis tests need no hosted credentials. The Upstash
# adapter validates these on the server before use. Copy to .env.local; never commit it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Explicit opt-in for future demo-only controls. Never expose the secret publicly.
DEMO_MODE=false
# Required when DEMO_MODE=true; use a random value at least 32 characters long.
DEMO_SECRET=
